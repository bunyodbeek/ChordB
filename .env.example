# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
BOT_TOKEN=123456789:replace-me

# Public HTTPS URL of the Mini App (tunnel URL locally, real domain in prod)
WEBAPP_URL=https://chordb.shredzville.com

# Postgres, async driver. Locally: the compose postgres or your own.
# Prod: the "chordb" database in the existing container, bound to 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://chordb:chordb@127.0.0.1:5432/chordb

# dev | prod  (prod disables /api/docs and the dev initData helper)
ENV=dev

# Only for running backend tests (database is wiped on every test)
TEST_DATABASE_URL=postgresql+asyncpg://chordb:chordb@127.0.0.1:5432/chordb_test
