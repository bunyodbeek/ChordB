# Copy to .env and fill in. Never commit .env.

# Token from @BotFather
BOT_TOKEN=123456789:replace-me

# Public HTTPS URL of the Mini App (tunnel URL locally, real domain in prod).
# scripts/dev.sh overwrites this with the tunnel URL on every start.
WEBAPP_URL=https://chordb.shredzville.com

# Postgres, async driver. Locally: the compose postgres or your own.
# Prod: the "chordb" database in the existing container, bound to 127.0.0.1.
DATABASE_URL=postgresql+asyncpg://chordb:chordb@127.0.0.1:5432/chordb

# Host port the local compose Postgres is published on (127.0.0.1 only). Change it, and
# the port in DATABASE_URL and TEST_DATABASE_URL, if another project already uses 5432.
POSTGRES_PORT=5432

# HTTPS tunnel scripts/dev.sh starts: cloudflared (default, no interstitial) | ngrok | none
TUNNEL=cloudflared

# Reserved ngrok domain for scripts/dev.sh, e.g. chordb-dev.ngrok-free.app. Empty = a new
# random tunnel URL on every start, which has to be pasted into @BotFather again.
NGROK_DOMAIN=

# dev | prod  (prod disables /api/docs and the dev initData helper)
ENV=dev

# Only for running backend tests (database is wiped on every test)
TEST_DATABASE_URL=postgresql+asyncpg://chordb:chordb@127.0.0.1:5432/chordb_test

# Time zone for scheduled notifications (weekly reminder: Sunday 19:00)
NOTIFY_TZ=Asia/Tashkent

# Telegram user ids allowed to manage songs (/api/admin), comma-separated.
ADMIN_IDS=

# Chord detection (backend + worker). Uploads wait in MEDIA_DIR until the worker has
# analysed them; both processes must see the same directory (docker: the "media" volume).
# Empty = <system temp>/chordb-media.
MEDIA_DIR=
ANALYZE_FREE_PER_DAY=3
ANALYZE_MAX_UPLOAD_MB=50
ANALYZE_CONCURRENCY=2
ANALYZE_TIMEOUT_SEC=180

# Premium: users pay by card transfer and upload the receipt in the Mini App; an admin
# approves it in the admin panel (/admin). Prices in soʻm.
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=
PREMIUM_PRICE_MONTH=20000
PREMIUM_PRICE_QUARTER=45000

# Song links for Instagram etc.: t.me/<BOT_USERNAME>/<WEBAPP_SHORT_NAME>?startapp=song_<id>.
# WEBAPP_SHORT_NAME is the Mini App's short name from @BotFather (/newapp); leave it empty
# to use the bot's main Mini App instead.
BOT_USERNAME=
WEBAPP_SHORT_NAME=
