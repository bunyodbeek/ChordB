# Copy to .env.local (start.ps1 does this for you on every start).
# Signed initData for running outside Telegram; expires after 24h. Generate with:
#   cd backend && uv run python -m app.dev_init_data --id 1001 --first-name Bunyod
# Ignored inside Telegram, where the real initData is used.
VITE_DEV_INIT_DATA=
